index cdcab9532..4da8d06c4 100644
--- i/src/termio/Termio.zig
+++ w/src/termio/Termio.zig
@@ -641,6 +641,84 @@ pub fn focusGained(self: *Termio, td: *ThreadData, focused: bool) !void {
