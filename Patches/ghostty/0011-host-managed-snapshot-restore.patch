+/// Transactionally replace the terminal model with a complete GHOSTSNP
+/// payload. Decoding and configuration happen off the renderer lock; the
+/// critical section only validates the grid and swaps fully-owned state.
+pub fn restoreSnapshot(self: *Termio, buf: []const u8) !void {
+    if (buf.len == 0) return error.EmptySnapshot;
+
+    var reader: std.Io.Reader = .fixed(buf);
+    var decoded = try terminalpkg.snapshot.decodeExact(
+        self.alloc,
+        global.io(),
+        &reader,
+        .{ .max_continuation_bytes = 64 * 1024 },
+    );
+    defer decoded.deinit(self.alloc);
+
+    // The daemon snapshot carries runtime terminal state, while the embedded
+    // surface remains authoritative for configurable defaults and image
+    // loading policy.
+    const restored = &decoded.terminal.?;
+    restored.setDefaultCursorStyle(self.config.cursor_style);
+    restored.setDefaultCursorBlink(self.config.cursor_blink);
+    restored.colors.palette.changeDefault(self.config.palette);
+    restored.colors.background.default = self.config.background.toTerminalRGB();
+    restored.colors.foreground.default = self.config.foreground.toTerminalRGB();
+    restored.colors.cursor.default = cursor: {
+        const color = self.config.cursor_color orelse break :cursor null;
+        break :cursor color.toTerminalRGB() orelse break :cursor null;
+    };
+    try restored.setKittyGraphicsSizeLimit(
+        self.alloc,
+        self.config.image_storage_limit,
+    );
+    restored.setKittyGraphicsLoadingLimits(
+        .allWithTempDir(global.tmpDirPath()),
+    );
+
+    const handler: StreamHandler = .{
+        .alloc = self.alloc,
+        .termio_mailbox = &self.mailbox,
+        .surface_mailbox = self.surface_mailbox,
+        .renderer_state = self.renderer_state,
+        .renderer_wakeup = self.renderer_wakeup,
+        .renderer_mailbox = self.renderer_mailbox,
+        .size = &self.size,
+        .terminal = &self.terminal,
+        .osc_color_report_format = self.config.osc_color_report_format,
+        .clipboard_write = self.config.clipboard_write,
+        .enquiry_response = self.config.enquiry_response,
+    };
+    var replacement_stream: StreamHandler.Stream = .init(.{
+        .allocator = self.alloc,
+        .handler = handler,
+    });
+    errdefer replacement_stream.deinit();
+
+    self.renderer_state.mutex.lockUncancelable(global.io());
+    defer self.renderer_state.mutex.unlock(global.io());
+
+    const grid = self.size.grid();
+    if (restored.cols != grid.columns or restored.rows != grid.rows) {
+        return error.SnapshotGridMismatch;
+    }
+
+    self.terminal_stream.deinit();
+    self.terminal.deinit(self.alloc);
+    self.terminal = decoded.toOwned();
+    self.terminal.width_px = self.terminal.cols * self.size.cell.width;
+    self.terminal.height_px = self.terminal.rows * self.size.cell.height;
+    self.terminal_stream = replacement_stream;
+
+    switch (decoded.continuation) {
+        .ground => {},
+        .bytes => |bytes| self.terminal_stream.nextSlice(bytes),
+    }
+
+    self.renderer_wakeup.notify() catch {};
+}
+
