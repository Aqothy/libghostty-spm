index 527739a82..16ba52aaa 100644
--- i/src/apprt/embedded.zig
+++ w/src/apprt/embedded.zig
@@ -1655,6 +1655,19 @@ pub const CAPI = struct {
         surface.core_surface.io.processOutput(ptr[0..len]);
     }
 
+    export fn ghostty_surface_restore_snapshot(
+        surface: *Surface,
+        ptr: [*]const u8,
+        len: usize,
+    ) bool {
+        if (len == 0) return false;
+        surface.core_surface.io.restoreSnapshot(ptr[0..len]) catch |err| {
+            log.warn("error restoring terminal snapshot err={}", .{err});
+            return false;
+        };
+        return true;
+    }
