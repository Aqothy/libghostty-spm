+/**
+ * Transactionally replace a host-managed surface's terminal model from one
+ * complete GHOSTSNP payload. The payload is decoded before the renderer lock
+ * is acquired and installed only when its grid matches the current surface.
+ * Returns true after the replacement is fully installed.
+ */
+GHOSTTY_API bool ghostty_surface_restore_snapshot(ghostty_surface_t, const uint8_t*, uintptr_t);
 GHOSTTY_API void ghostty_surface_process_exit(ghostty_surface_t, uint32_t, uint64_t);
